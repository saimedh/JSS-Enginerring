// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
}

model Service {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String
  body        String    @db.Text
  icon        String?
  image       String?
  order       Int       @default(0)
  published   Boolean   @default(true)
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Industry {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  summary   String
  image     String?
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Client {
  id        String    @id @default(cuid())
  name      String
  location  String
  logoUrl   String?
  order     Int       @default(0)
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  location    String
  year        Int
  images      String[]
  status      String   @default("Completed")
  featured    Boolean  @default(false)
  clientId    String?
  industryId  String?
  serviceId   String?
  client      Client?  @relation(fields: [clientId], references: [id])
  industry    Industry? @relation(fields: [industryId], references: [id])
  service     Service? @relation(fields: [serviceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  company   String
  quote     String   @db.Text
  createdAt DateTime @default(now())
}

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  company   String?
  phone     String
  email     String
  service   String?
  industry  String?
  location  String?
  message   String        @db.Text
  fileUrl   String?
  status    EnquiryStatus @default(NEW)
  notes     String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Download {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String @db.Text
}

